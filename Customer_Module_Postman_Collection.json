{
  "info": {
    "name": "Stone Market India - Customer Module APIs",
    "description": "Production-ready Postman collection covering all endpoints of the Customer Module (Profile, Inquiries, Quotes, Estimates, Favorites, Addresses, Notifications, Security, Support, and Policies).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "YOUR_CUSTOMER_JWT_TOKEN",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{customerToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Profile & Dashboard",
      "item": [
        {
          "name": "GET Customer Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/customer/profile"
          }
        },
        {
          "name": "PUT Update Customer Profile",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/customer/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Vikram Malhotra\",\n  \"whatsapp_number\": \"9111111118\",\n  \"email\": \"vikram.malhotra@gmail.com\",\n  \"city\": \"Jaipur\",\n  \"state\": \"Rajasthan\",\n  \"bio\": \"Real Estate Developer and Natural Stone Connoisseur\"\n}",
              "options": {
