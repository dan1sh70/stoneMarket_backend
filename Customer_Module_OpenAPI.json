{
  "openapi": "3.0.3",
  "info": {
    "title": "Stone Market India - Customer Module REST API",
    "version": "1.0.0",
    "description": "Complete, production-ready REST API documentation for the Customer Module of Stone Market India, covering profile, personal details, inquiries, quotations, estimates, favorites, addresses, notifications, security, support, and platform policies."
  },
  "servers": [
    {
      "url": "http://localhost:5000/api",
      "description": "Local Development Server"
    },
    {
      "url": "https://api.stonemarketindia.com/api",
      "description": "Production Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Standard JWT Bearer token obtained via /api/v1/auth/login or /api/auth/login"
      }
    },
    "schemas": {
      "StandardResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Operation completed successfully"
          },
          "data": {
            "type": "object"
          },
          "errors": {
            "type": "object",
            "nullable": true,
            "example": null
          },
          "meta": {
            "type": "object",
            "nullable": true,
            "properties": {
              "current_page": {
                "type": "integer",
                "example": 1
              },
              "per_page": {
                "type": "integer",
                "example": 10
              },
              "total": {
                "type": "integer",
                "example": 45
              },
              "last_page": {
                "type": "integer",
                "example": 5
              }
            }
          }
        }
      },
      "CustomerProfile": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "example": "6ae467433fd4377ea5c62125"
          },
          "full_name": {
            "type": "string",
            "example": "Vikram Malhotra"
          },
          "profile_picture": {
            "type": "string",
            "example": "https://images.unsplash.com/photo-1534528741775"
          },
          "registered_mobile": {
            "type": "string",
            "example": "9111111118"
          },
          "whatsapp_number": {
            "type": "string",
            "example": "9111111118"
          },
          "email": {
            "type": "string",
            "example": "customer.test@stonemarketindia.com"
          },
          "city": {
            "type": "string",
            "example": "Jaipur"
          },
          "state": {
            "type": "string",
            "example": "Rajasthan"
          },
          "account_type": {
            "type": "string",
            "example": "customer"
          },
          "account_verification_status": {
            "type": "string",
            "enum": [
              "unverified",
              "pending",
              "verified",
              "rejected"
            ],
            "example": "verified"
          },
          "customer_rating": {
            "type": "number",
            "example": 4.8
          },
          "number_of_reviews": {
            "type": "integer",
            "example": 5
          },
          "membership_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/customer/profile": {
      "get": {
        "summary": "Retrieve authenticated customer profile",
        "tags": [
          "Profile"
        ],
        "responses": {
          "200": {
            "description": "Customer profile retrieved"
          },
          "401": {
            "description": "Unauthenticated"
          }
        }
      },
      "put": {
        "summary": "Update editable customer profile information",
        "tags": [
          "Profile"
        ],
        "responses": {
          "200": {
            "description": "Profile updated"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/customer/profile/photo": {
      "post": {
        "summary": "Upload or update customer profile picture",
        "tags": [
          "Profile"
        ],
        "responses": {
          "200": {
            "description": "Photo updated"
          }
        }
      },
      "delete": {
        "summary": "Remove customer profile picture and restore avatar",
        "tags": [
          "Profile"
        ],
        "responses": {
          "200": {
            "description": "Photo removed"
          }
        }
      }
    },
    "/customer/dashboard": {
      "get": {
        "summary": "Aggregated real-time metrics and dashboard summary",
        "tags": [
          "Profile"
        ],
        "responses": {
          "200": {
            "description": "Dashboard data"
          }
        }
      }
    },
    "/customer/personal-details": {
      "get": {
        "summary": "Retrieve personal details",
        "tags": [
          "Personal Details"
        ]
      },
      "put": {
        "summary": "Update personal details",
        "tags": [
          "Personal Details"
        ]
      }
    },
    "/customer/personal-details/verify-mobile": {
      "post": {
        "summary": "Request OTP to update registered mobile phone",
        "tags": [
          "Personal Details"
        ]
      }
    },
    "/customer/personal-details/verify-otp": {
      "post": {
        "summary": "Verify OTP and finalize mobile update",
        "tags": [
          "Personal Details"
        ]
      }
    },
    "/customer/inquiries": {
      "get": {
        "summary": "List customer inquiries with search and filters",
        "tags": [
          "Inquiries"
        ]
      }
    },
    "/customer/inquiries/{inquiry_id}/details": {
      "get": {
        "summary": "Retrieve full inquiry details",
        "tags": [
          "Inquiries"
        ]
      }
    },
    "/customer/inquiries/{inquiry_id}/tracking": {
      "get": {
        "summary": "Retrieve 5-step inquiry workflow tracking",
        "tags": [
          "Inquiries"
        ]
      }
    },
    "/customer/inquiries/{inquiry_id}/download": {
      "get": {
        "summary": "Generate and download customer inquiry PDF",
        "tags": [
          "Inquiries"
        ]
      }
    },
    "/customer/inquiries/{inquiry_id}/close": {
      "post": {
        "summary": "Customer closes inquiry with reason",
        "tags": [
          "Inquiries"
        ]
      }
    },
    "/customer/quotes/request": {
      "post": {
        "summary": "Submit stone requirement quotation request",
        "tags": [
          "Quotes"
        ]
      }
    },
    "/customer/quotes/request-options": {
      "get": {
        "summary": "Get quotation form dropdown options",
        "tags": [
          "Quotes"
        ]
      }
    },
    "/customer/quotations": {
      "get": {
        "summary": "List all quotations received from suppliers",
        "tags": [
          "Quotations"
        ]
      }
    },
    "/customer/quotations/{quote_id}": {
      "get": {
        "summary": "Retrieve detailed supplier quotation",
        "tags": [
          "Quotations"
        ]
      }
    },
    "/customer/quotations/{quote_id}/download": {
      "get": {
        "summary": "Download supplier quotation PDF",
        "tags": [
          "Quotations"
        ]
      }
    },
    "/customer/quotations/compare": {
      "post": {
        "summary": "Compare multiple quotations side-by-side",
        "tags": [
          "Quotations"
        ]
      }
    },
    "/customer/estimates": {
      "get": {
        "summary": "List customer estimates (slab and particular)",
        "tags": [
          "Estimates"
        ]
      },
      "post": {
        "summary": "Create slab or particular estimate with automated area/amount calculation",
        "tags": [
          "Estimates"
        ]
      }
    },
    "/customer/estimates/{estimate_id}/download": {
      "get": {
        "summary": "Download slab or particular estimate PDF",
        "tags": [
          "Estimates"
        ]
      }
    },
    "/customer/favorites": {
      "get": {
        "summary": "List customer saved stones",
        "tags": [
          "Favorites"
        ]
      },
      "post": {
        "summary": "Save stone product to favorites",
        "tags": [
          "Favorites"
        ]
      }
    },
    "/customer/favorites/{product_id}": {
      "delete": {
        "summary": "Remove product from favorites",
        "tags": [
          "Favorites"
        ]
      }
    },
    "/customer/addresses": {
      "get": {
        "summary": "List customer delivery and project addresses",
        "tags": [
          "Addresses"
        ]
      },
      "post": {
        "summary": "Create new delivery address",
        "tags": [
          "Addresses"
        ]
      }
    },
    "/customer/addresses/{address_id}/default": {
      "patch": {
        "summary": "Set address as default",
        "tags": [
          "Addresses"
        ]
      }
    },
    "/customer/notifications": {
      "get": {
        "summary": "List customer in-app notifications",
        "tags": [
          "Notifications"
        ]
      },
      "delete": {
        "summary": "Clear customer notifications",
        "tags": [
          "Notifications"
        ]
      }
    },
    "/customer/settings/quiet-hours": {
      "get": {
        "summary": "Retrieve quiet hours configuration",
        "tags": [
          "Settings"
        ]
      },
      "put": {
        "summary": "Update quiet hours schedule and timezone",
        "tags": [
          "Settings"
        ]
      }
    },
    "/customer/security/change-password": {
      "put": {
        "summary": "Change account password with verification",
        "tags": [
          "Security"
        ]
      }
    },
    "/customer/security/sessions": {
      "get": {
        "summary": "List active customer login sessions",
        "tags": [
          "Security"
        ]
      },
      "delete": {
        "summary": "Revoke all other active sessions",
        "tags": [
          "Security"
        ]
      }
    },
    "/customer/support/tickets": {
      "get": {
        "summary": "List customer support tickets",
        "tags": [
          "Help & Support"
        ]
      },
      "post": {
        "summary": "Create new support ticket",
        "tags": [
          "Help & Support"
        ]
      }
    },
    "/app/about": {
      "get": {
        "summary": "Get About Stone Market India details",
        "tags": [
          "App Info"
        ]
      }
    },
    "/app/version": {
      "get": {
        "summary": "Get app version and update requirements",
        "tags": [
          "App Info"
        ]
      }
    },
    "/app/policies": {
      "get": {
        "summary": "Get legal policies and URLs",
        "tags": [
          "App Info"
        ]
      }
    }
  }
}